# ---------------------------------------------------------------------------
# Dependencies — installed with `composer install` / `npm install`, never committed.
# ---------------------------------------------------------------------------
/vendor/
/node_modules/

# ---------------------------------------------------------------------------
# IMPORTANT: assets/js/admin.js and assets/css/admin.css are generated by
# webpack but ARE intentionally tracked. WordPress plugins ship as ready-to-run
# directories, so the built assets must exist in a clone, in a GitHub source
# archive and in the WordPress.org package. Rebuild them with `npm run buildr`.
# Do not add them here. See CONTRIBUTING.md.
# ---------------------------------------------------------------------------

# Other build output that is NOT part of the distributed plugin
/dist/
/build/
*.map

# Packaging artefacts
*.zip
*.tar
*.tar.gz
/bagisto-sync-for-woocommerce/

# Environment and local configuration
.env
.env.*
!.env.example
*.local
wp-cli.local.yml

# Logs, database dumps and backups — never commit these
*.log
/logs/
debug.log
*.sql
*.sql.gz
*.sqlite
*.bak
*.backup
*.orig
*.rej

# Test and tooling caches
/coverage/
.phpunit.result.cache
.phpcs.cache
phpcs.xml
phpunit.xml
.cache/
/playwright-report/
/test-results/

# Editors and OS cruft
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini
