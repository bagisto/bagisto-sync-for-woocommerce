{
	"name": "bagisto-sync-for-woocommerce",
	"version": "1.0.0",
	"description": "Bagisto Sync for WooCommerce",
	"main": "index.js",
	"files": [
		"assets",
		"helper",
		"includes",
		"languages",
		"templates",
		"bagisto-sync-for-woocommerce.php",
		"index.php",
		"license.txt",
		"readme.txt",
		"CHANGELOG.md"
	],
	"scripts": {
		"build-old": "webpack",
		"watch": "webpack --watch",
		"buildr": "cross-env NODE_ENV=production webpack",
		"build": "./bin/build.sh",
		"postbuild": "npm run i18n",
		"i18n": "npm run -s i18n:js && npm run -s i18n:check && npm run -s i18n:pot && npm run -s i18n:build && npm run i18n:json",
		"i18n:build": "php bin/combine-pot-files.php languages/bagisto-sync-for-woocommerce.po languages/bagisto-sync-for-woocommerce.pot",
		"i18n:check": "grunt checktextdomain",
		"i18n:js": "cross-env NODE_ENV=production babel src -o /dev/null",
		"i18n:json": "./bin/make-i18n-json.sh",
		"i18n:pot": "grunt makepot",
		"start": "webpack --watch",
		"zip": "wp-scripts plugin-zip"
	},
	"author": "webkul",
	"license": "GPL-3.0-or-later",
	"devDependencies": {
		"@babel/cli": "^7.12.8",
		"@babel/core": "^7.0.0-0",
		"@babel/eslint-parser": "^7.15.8",
		"@babel/plugin-transform-async-to-generator": "8.0.1",
		"@babel/plugin-transform-react-jsx": "^7.18.6",
		"@babel/plugin-transform-runtime": "^7.24.7",
		"@babel/preset-env": "^7.24.8",
		"@babel/preset-stage-0": "^7.0.0",
		"@babel/runtime-corejs2": "^7.29.7",
		"@wordpress/babel-plugin-import-jsx-pragma": "1.1.3",
		"@wordpress/babel-plugin-makepot": "2.1.3",
		"@wordpress/babel-preset-default": "3.0.2",
		"@wordpress/scripts": "^33.0.0",
		"autoprefixer": "^10.0.2",
		"babel-core": "7.0.0-bridge.0",
		"babel-loader": "8.0.6",
		"babel-plugin-transform-class-properties": "^6.10.2",
		"babel-plugin-transform-es2015-template-literals": "6.22.0",
		"cross-env": "6.0.3",
		"css-loader": "^7.1.4",
		"grunt": "^1.1.0",
		"grunt-checktextdomain": "1.0.1",
		"grunt-wp-i18n": "1.0.3",
		"mini-css-extract-plugin": "2.7.2",
		"sass": "1.34.0",
		"sass-loader": "10.1.1",
		"style-loader": "0.23.1",
		"watch": "^0.13.0",
		"webpack": "^5.108.4",
		"webpack-cli": "5.1.4"
	},
	"dependencies": {
		"@wordpress/element": "^6.23.0",
		"@wordpress/hooks": "2.6.0",
		"@wordpress/i18n": "3.6.1",
		"jquery": "^3.7.1",
		"select2": "^4.1.0-rc.0"
	},
	"overrides": {
		"lodash": "^4.18.1"
	}
}
