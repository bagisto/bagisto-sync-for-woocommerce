# https://editorconfig.org
# Matches the conventions already used in this repository.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# WordPress Coding Standards: tabs for indentation.
[*.php]
indent_style = tab
indent_size = 4

[*.{js,jsx,scss,css}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{txt,pot,po}]
indent_style = space
trim_trailing_whitespace = false
